{
  "name": "dsh-memory-sync",
  "version": "0.3.0",
  "description": "Keep a memory folder in sync across two machines: LAN HTTP snapshots, offline snapshot files, or an SSH peer chain. Includes a desktop settings page and an Android config form.",
  "type": "module",
  "license": "MIT",
  "author": "QIC-9821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIC-9821/dsh-memory-sync.git"
  },
  "homepage": "https://github.com/QIC-9821/dsh-memory-sync#readme",
  "bugs": {
    "url": "https://github.com/QIC-9821/dsh-memory-sync/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "MANUAL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "git",
    "sync",
    "startup",
    "snapshot",
    "android"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
