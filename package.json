{
  "name": "dsh-memory-sync",
  "version": "0.1.2",
  "description": "Sync a git-backed memory folder with a peer machine on every DeepSeek Harness startup — no daemon, no cron, no manual pull.",
  "type": "module",
  "license": "MIT",
  "author": "QIC-9821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIC-9821/dsh-memory-sync.git"
  },
  "homepage": "https://github.com/QIC-9821/dsh-memory-sync#readme",
  "bugs": {
    "url": "https://github.com/QIC-9821/dsh-memory-sync/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "git",
    "sync",
    "startup"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
